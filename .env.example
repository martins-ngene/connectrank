# ==========================================
# ConnectRank Environment Variables Template
# Copy this file to .env or configure in your deployment platform
# ==========================================

# 1. Environment & Network Configurations
ENVIRONMENT=development
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 2. Frontend React / Vite Configuration
VITE_API_URL=http://localhost:8080

# 3. Sentry APM & Error Tracking (Optional)
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
